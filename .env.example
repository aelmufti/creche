# Analytics privacy-first (cookieless). Laisser vide pour désactiver.
# Renseigner le domaine enregistré sur Plausible (ex. creche-ou-nounou.fr).
PUBLIC_PLAUSIBLE_DOMAIN=

# IndexNow : la clé est le nom du fichier public/<clé>.txt (déjà généré).
# Le ping se fait via : HOST=creche-ou-nounou.fr node scripts/indexnow-ping.mjs
