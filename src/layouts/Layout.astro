---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import { enrichJsonLd } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  /** Chemin de la page pour le canonical (défaut : URL courante). */
  path?: string;
  /** Objets JSON-LD à injecter dans le <head>. */
  jsonLd?: Record<string, unknown>[];
  /** Chemin de l'image Open Graph (défaut : image de marque). */
  ogImage?: string;
  /** Type Open Graph : "article" pour les guides et pages locales. */
  ogType?: "website" | "article";
  /** Dates ISO (AAAA-MM-JJ) pour article:published_time / modified_time. */
  datePublished?: string;
  dateModified?: string;
  /** Texte alternatif de l'image Open Graph (défaut : le titre). */
  ogImageAlt?: string;
  /** Exclure la page de l'index (404, pages utilitaires). */
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  jsonLd = [],
  ogImage = "/og-default.png",
  ogType = "website",
  datePublished,
  dateModified,
  ogImageAlt,
  noindex = false,
} = Astro.props;
// Politique d'URL : pas de trailing slash (sauf racine) — cohérent avec le
// sitemap et le trailingSlash:false de Vercel.
const rawPath = path ?? Astro.url.pathname;
const canonicalPath = rawPath !== "/" && rawPath.endsWith("/") ? rawPath.slice(0, -1) : rawPath;
const canonical = new URL(canonicalPath, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
// Graphe d'entités : chaque Article reçoit @id, image, mainEntityOfPage et des
// author/publisher reliés à la même Person/Organization (cf. src/lib/schema.ts).
const ld = enrichJsonLd(jsonLd, { canonical, image: ogImageUrl });
// Snippets et aperçus sans restriction : image large (Discover, AI Overviews),
// extrait de longueur libre. Google, Bing et les moteurs IA lisent ces directives.
const robots = noindex
  ? "noindex, follow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const nav = [
  { href: "/", label: "Comparateur" },
  { href: "/guides", label: "Guides" },
  { href: "/cout-garde-enfant", label: "Par département" },
  { href: "/methodologie", label: "Méthodologie" },
];
const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? current === "/" : current.startsWith(href);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <meta name="theme-color" content="#EDE8E0" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="creche-ou-nounou.fr" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt ?? title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {ogType === "article" && datePublished && (
      <meta property="article:published_time" content={datePublished} />
    )}
    {ogType === "article" && dateModified && (
      <meta property="article:modified_time" content={dateModified} />
    )}
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      ld.map((obj) => (
        <script type="application/ld+json" set:html={JSON.stringify(obj)} />
      ))
    }
    <!--
      Navigation quasi instantanée (Speculation Rules) : prefetch du document au
      survol d'un lien interne. « prefetch » et non « prerender » : un prérendu
      exécuterait le script d'analytics et compterait des pages jamais vues.
    -->
    <script type="speculationrules" is:inline>
      {
        "prefetch": [
          {
            "where": { "and": [{ "href_matches": "/*" }, { "not": { "href_matches": "/data/*" } }] },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
    <script is:inline>
      // Garde-fou de confidentialité. Le scénario de l'utilisateur (revenu, code
      // postal, situation familiale) vit dans la query string, écrite par le
      // calculateur via replaceState. L'intégration Astro de Vercel Analytics
      // n'envoie déjà que le pathname (disableAutoTrack + path calculé au build),
      // mais ce beforeSend verrouille la garantie donnée sur /confidentialite au
      // lieu de la faire dépendre d'un détail d'implémentation d'une dépendance.
      // Droit d'opposition (/confidentialite#opposition) : si le visiteur s'est
      // opposé, ou si son navigateur envoie Global Privacy Control, l'événement
      // est abandonné (beforeSend renvoie null) et rien n'est transmis.
      window.webAnalyticsBeforeSend = function (event) {
        try {
          if (navigator.globalPrivacyControl === true) return null;
          if (localStorage.getItem("cn-audience-optout") === "1") return null;
        } catch (e) {}
        try {
          var u = new URL(event.url, window.location.origin);
          return Object.assign({}, event, { url: u.origin + u.pathname });
        } catch (e) {
          return event;
        }
      };
    </script>
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <header class="border-b-[3px] border-border bg-background">
        <div class="container flex flex-wrap items-center justify-between gap-3 py-3">
          <a href="/" class="text-lg font-extrabold uppercase tracking-brutal">
            <span class="marker">Crèche ou nounou</span> ?
          </a>
          <nav aria-label="Navigation principale" class="flex flex-wrap gap-2">
            {
              nav.map((n) => (
                <a
                  href={n.href}
                  aria-current={isActive(n.href) ? "page" : undefined}
                  class:list={[
                    "border-[3px] border-border px-3 py-1.5 text-xs font-bold uppercase tracking-brutal",
                    isActive(n.href) ? "bg-foreground text-background" : "bg-card hover:bg-muted",
                  ]}
                >
                  {n.label}
                </a>
              ))
            }
          </nav>
        </div>
      </header>

      <main class="container flex-1 py-8"><slot /></main>

      <footer class="border-t-[3px] border-border bg-foreground text-background">
        <div
          class="container flex flex-col gap-3 py-6 text-sm sm:flex-row sm:items-center sm:justify-between"
        >
          <p>
            Fait par{" "}
            <a
              href="https://aelm.dev"
              class="marker font-bold"
              style="background:#D4A800;color:#0D0D0D"
            >
              Ali El Mufti
            </a>
          </p>
          <nav aria-label="Liens de bas de page" class="flex flex-wrap gap-4">
            <a href="/guides" class="underline">Guides</a>
            <a href="/cout-garde-enfant" class="underline">Coût par département</a>
            <a href="/observatoire-cout-garde-2026" class="underline">Observatoire</a>
            <a href="/glossaire" class="underline">Glossaire</a>
            <a href="/methodologie" class="underline">Méthodologie</a>
            <a href="/a-propos" class="underline">À propos</a>
            <a href="/mentions-legales" class="underline">Mentions légales</a>
            <a href="/confidentialite" class="underline">Confidentialité</a>
            <a href="/conditions-utilisation" class="underline">Conditions d'utilisation</a>
            <a href="https://github.com/aelmufti/creche" class="underline">Code source (open source)</a>
            <a href="https://freelance-ou-cdi.fr" class="underline">freelance-ou-cdi.fr</a>
          </nav>
        </div>
        <div class="container space-y-1 pb-6 text-xs opacity-70">
          <p>
            Site indépendant, sans lien avec la CAF, l'Urssaf ou l'administration. Estimation
            indicative, ce n'est pas un avis officiel. Vérifiez sur caf.fr / pajemploi.urssaf.fr.
          </p>
          <p>
            Données locales : Urssaf Caisse nationale, base « Salariés des particuliers employeurs
            en 2024 », sous <a href="/mentions-legales#credits" class="underline">licence ODbL</a>.
            Données géographiques : Insee, La Poste (Licence Ouverte 2.0).
          </p>
        </div>
      </footer>
    </div>
    <Analytics />
  </body>
</html>
