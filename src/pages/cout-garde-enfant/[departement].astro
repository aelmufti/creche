---
import Layout from "../../layouts/Layout.astro";
import { comparer, type Inputs } from "../../engine";
import { TARIFS_DEPARTEMENTS, TARIFS_NATIONAL, SOURCE_TARIFS } from "../../data/tarifs-locaux";
import departementsJson from "../../data/departements.json";
import codesPostauxJson from "../../data/codes-postaux.json";
import { fmtEuro, fmtEuro2, fmtDateFr, fmtRang } from "../../lib/format";
import { DATES } from "../../data/content-dates.mjs";
import { slugify } from "../../lib/slug";
import { VILLES } from "../../data/villes";
import { deptLoc, deptLocCap } from "../../data/departements-loc";
import {
  rangAma,
  exAequoAma,
  quartile,
  departementsComparables,
  basculesLocales,
  NB_DEPARTEMENTS,
  MOYENNE_AMA,
  DEPT_MAX,
  DEPT_MIN,
} from "../../lib/departements-stats";

const site = "https://creche-ou-nounou.fr";

export function getStaticPaths() {
  const departements = departementsJson as Record<string, string>;
  const codesPostaux = codesPostauxJson as Record<string, string>;
  // Un code postal représentatif par département (pour le lien vers le calculateur).
  const cpByDept: Record<string, string> = {};
  for (const [cp, dep] of Object.entries(codesPostaux)) {
    if (!(dep in cpByDept)) cpByDept[dep] = cp;
  }
  return Object.keys(TARIFS_DEPARTEMENTS)
    .filter((code) => departements[code])
    .map((code) => {
      const nom = departements[code];
      return {
        params: { departement: slugify(nom) },
        props: { code, nom, cp: cpByDept[code] ?? "" },
      };
    });
}

const { code, nom, cp } = Astro.props;
// Locatif correct (« dans le Nord », « à Paris ») plutôt qu'un « en » systématique.
const loc = deptLoc(code, nom);
const locCap = deptLocCap(code, nom);
const tarifs = { ...TARIFS_NATIONAL, ...TARIFS_DEPARTEMENTS[code] };

// Scénario d'exemple (clairement annoncé, personnalisable via le calculateur).
const EX = { revenu: 3000, heures: 160 };
const exemple: Inputs = {
  revenuMensuelNet: EX.revenu,
  situation: "couple",
  nbEnfants: 1,
  agesGardes: [1],
  heuresMois: EX.heures,
  tauxHoraireAma: tarifs.tauxHoraireAma,
  coutHoraireDomicile: tarifs.coutHoraireDomicile,
  tarifMicroCreche: tarifs.tarifMicroCreche,
};
const { classement, gagnant, ecartAuSuivant } = comparer(exemple);

const amaEcartNational = tarifs.tauxHoraireAma - TARIFS_NATIONAL.tauxHoraireAma;
const amaVsNat =
  amaEcartNational > 0.001
    ? `supérieur de ${fmtEuro2(amaEcartNational)} à la moyenne nationale`
    : amaEcartNational < -0.001
      ? `inférieur de ${fmtEuro2(-amaEcartNational)} à la moyenne nationale`
      : "proche de la moyenne nationale";

// --- Positionnement national (calculé) : donne à chaque page une analyse qui
// lui est propre, au lieu d'un gabarit où seuls le nom et deux nombres changent.
const rang = rangAma(code);
const exAequo = exAequoAma(code);
// Les taux URSSAF sont arrondis au centime : la majorité des départements
// partagent leur rang. Le taire ferait passer un artefact de tri pour un fait.
const exAequoTxt =
  exAequo > 0 ? ` (rang partagé avec ${exAequo} autre${exAequo > 1 ? "s" : ""} département${exAequo > 1 ? "s" : ""} au même tarif)` : "";
const q = quartile(code);
const comparables = departementsComparables(code);
const bascules = basculesLocales(tarifs);

const positionTxt =
  q === 1
    ? "dans le quart des départements les plus chers"
    : q === 2
      ? "au-dessus de la médiane nationale"
      : q === 3
        ? "en dessous de la médiane nationale"
        : "dans le quart des départements les moins chers";

const analyse =
  q === 1
    ? `${locCap}, la rémunération des assistantes maternelles se situe ${positionTxt} de France (${fmtRang(rang)} sur ${NB_DEPARTEMENTS}, contre ${fmtEuro2(MOYENNE_AMA)}/h en moyenne nationale). Conséquence directe : l'écart de budget entre une assistante maternelle et une place en crèche y est plus resserré qu'ailleurs. Le tarif d'une crèche dépendant de vos revenus et non du marché local, elle devient compétitive à un niveau de revenu plus bas que dans les départements bon marché.`
    : q === 4
      ? `${locCap}, la rémunération des assistantes maternelles se situe ${positionTxt} de France (${fmtRang(rang)} sur ${NB_DEPARTEMENTS}, contre ${fmtEuro2(MOYENNE_AMA)}/h en moyenne nationale). L'assistante maternelle y conserve donc l'avantage budgétaire sur une plage de revenus plus large qu'ailleurs : il faut des revenus nettement plus élevés pour que la crèche, dont le tarif est indexé sur les ressources, reprenne la tête.`
      : `${locCap}, la rémunération des assistantes maternelles se situe ${positionTxt} (${fmtRang(rang)} sur ${NB_DEPARTEMENTS}, contre ${fmtEuro2(MOYENNE_AMA)}/h en moyenne). Le département n'a donc rien d'un cas extrême : le choix s'y joue surtout sur vos revenus et votre nombre d'heures de garde, plus que sur le niveau des tarifs locaux.`;

const slug = slugify(nom);
const path = `/cout-garde-enfant/${slug}`;
const villesDuDept = VILLES.filter((v) => v.dept === code);
const title = `Crèche ou nounou — ${nom} : coût réel 2026`;
const description = `${nom} : assistante maternelle à ${fmtEuro2(tarifs.tauxHoraireAma)}/h net (${fmtRang(rang)}/${NB_DEPARTEMENTS}, URSSAF 2024). Comparez crèche, nounou et garde à domicile.`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description,
    inLanguage: "fr-FR",
    datePublished: DATES.departements.published,
    dateModified: DATES.departements.modified,
    about: { "@type": "AdministrativeArea", name: nom },
    author: { "@type": "Person", name: "Ali El Mufti", url: "https://aelm.dev" },
    publisher: { "@type": "Organization", name: "creche-ou-nounou.fr", url: site },
    isPartOf: { "@type": "Dataset", name: SOURCE_TARIFS.source },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: `Combien coûte une assistante maternelle ${loc} ?`,
        acceptedAnswer: {
          "@type": "Answer",
          text: `${locCap}, le salaire horaire net moyen d'une assistante maternelle est de ${fmtEuro2(tarifs.tauxHoraireAma)}/h (données URSSAF 2024), avant CMG et crédit d'impôt. Le reste à charge réel dépend de vos revenus et du nombre d'heures.`,
        },
      },
      {
        "@type": "Question",
        name: `Crèche ou nounou ${loc} : lequel est le moins cher ?`,
        acceptedAnswer: {
          "@type": "Answer",
          text: `Pour un foyer à ${EX.revenu} €/mois avec 1 enfant gardé ${EX.heures} h/mois, le mode le moins cher ${loc} est « ${gagnant.label} » à ${fmtEuro(gagnant.netReel)}/mois en coût net réel. Le résultat varie selon votre situation : utilisez le comparateur pour votre cas.`,
        },
      },
      {
        "@type": "Question",
        name: `La garde d'enfant est-elle chère ${loc} ?`,
        acceptedAnswer: {
          "@type": "Answer",
          text: `${locCap}, le salaire horaire des assistantes maternelles se classe ${fmtRang(rang)} sur ${NB_DEPARTEMENTS} départements, à ${fmtEuro2(tarifs.tauxHoraireAma)}/h net contre ${fmtEuro2(MOYENNE_AMA)}/h en moyenne nationale (URSSAF 2024) — soit ${positionTxt}${exAequoTxt}. L'échelle nationale va de ${fmtEuro2(DEPT_MIN.tauxHoraireAma)}/h (${DEPT_MIN.nom}) à ${fmtEuro2(DEPT_MAX.tauxHoraireAma)}/h (${DEPT_MAX.nom}).`,
        },
      },
      ...(bascules.length > 0
        ? [
            {
              "@type": "Question",
              name: `À partir de quel revenu la crèche devient-elle plus intéressante ${loc} ?`,
              acceptedAnswer: {
                "@type": "Answer",
                text: `Avec les tarifs ${loc} (couple, 1 enfant, ${EX.heures} h/mois), le mode le moins cher change à partir de ${fmtEuro(bascules[0].revenu)}/mois de revenu net du foyer : « ${bascules[0].apres} » passe alors devant « ${bascules[0].avant} ». En dessous de ce seuil, « ${bascules[0].avant} » reste l'option la moins chère. Ce seuil est propre au département car il dépend des tarifs locaux et de la dégressivité du CMG.`,
              },
            },
          ]
        : []),
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: site + "/" },
      { "@type": "ListItem", position: 2, name: "Coût par département", item: site + "/cout-garde-enfant" },
      { "@type": "ListItem", position: 3, name: nom, item: site + path },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  path={path}
  jsonLd={jsonLd}
  ogType="article"
  datePublished={DATES.departements.published}
  dateModified={DATES.departements.modified}
  ogImage={`/og/dept-${slug}.png`}
>
  <article class="mx-auto flex max-w-3xl flex-col gap-6">
    <nav aria-label="Fil d'Ariane" class="text-xs text-muted-foreground">
      <a class="underline" href="/">Accueil</a> ›
      <a class="underline" href="/cout-garde-enfant">Coût par département</a> › {nom}
    </nav>

    <header>
      <h1 class="text-3xl font-extrabold sm:text-4xl">Crèche ou nounou — {nom} : coût réel 2026</h1>
      <p class="mt-2 text-xs text-muted-foreground">
        Mis à jour le {fmtDateFr(DATES.departements.modified)}.
      </p>
    </header>

    <!-- Réponse directe (answer-first, citable) -->
    <div class="card-brutal border-l-[8px] border-l-brutal-blue p-4 text-sm leading-relaxed">
      <p>
        <strong>{nom}</strong> — une assistante maternelle y est rémunérée en moyenne
        <strong>{fmtEuro2(tarifs.tauxHoraireAma)}/h net</strong> ({amaVsNat}), ce qui place le
        département <strong>{fmtRang(rang)} sur {NB_DEPARTEMENTS}</strong>. Une garde à domicile y revient à
        environ <strong>{fmtEuro2(tarifs.coutHoraireDomicile)}/h</strong> de coût total employeur —
        données <strong>URSSAF 2024</strong>.
      </p>
      <p class="mt-2">
        Pour un foyer à {EX.revenu} €/mois, 1 enfant gardé {EX.heures} h/mois, le mode le moins cher
        est <strong>{gagnant.label}</strong> à
        <span class="marker">{fmtEuro(gagnant.netReel)}/mois</span> en coût net réel{
          ecartAuSuivant > 0.5 ? `, soit ${fmtEuro(ecartAuSuivant)}/mois de moins que l'option suivante` : ""
        }.
      </p>
    </div>

    <section>
      <h2 class="text-xl font-extrabold">Comparatif des 5 modes — {nom} (exemple)</h2>
      <p class="mt-1 text-xs text-muted-foreground">
        Hypothèse : couple, {EX.revenu} €/mois, 1 enfant, {EX.heures} h/mois. Coût net réel = après
        crédit d'impôt 50 %.
      </p>
      <table class="card-brutal mt-3 w-full text-sm">
        <thead>
          <tr class="border-b-[3px] border-border text-left">
            <th class="p-2">#</th>
            <th class="p-2">Mode de garde</th>
            <th class="p-2 text-right">Coût net réel / mois</th>
          </tr>
        </thead>
        <tbody>
          {
            classement.map((r, i) => (
              <tr class="border-t border-border/30">
                <td class="p-2 tabular-nums">{i + 1}</td>
                <td class="p-2 font-bold">{r.label}</td>
                <td class="p-2 text-right tabular-nums">{fmtEuro(r.netReel)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="text-sm leading-relaxed">
      <h2 class="text-xl font-extrabold">Ce que ces tarifs changent concrètement {loc}</h2>
      <p class="mt-2">{analyse}</p>
      <p class="mt-2">
        Pour situer l'échelle : le salaire horaire net d'une assistante maternelle va de {
          fmtEuro2(DEPT_MIN.tauxHoraireAma)
        }/h ({DEPT_MIN.nom}) à {fmtEuro2(DEPT_MAX.tauxHoraireAma)}/h ({DEPT_MAX.nom}), pour une
        moyenne nationale de {fmtEuro2(MOYENNE_AMA)}/h. {locCap}, une garde à domicile revient à
        environ {fmtEuro2(tarifs.coutHoraireDomicile)}/h de coût total employeur, avant crédit
        d'impôt de 50 %.
      </p>
    </section>

    <section class="text-sm leading-relaxed">
      <h2 class="text-xl font-extrabold">À partir de quel revenu le verdict change {loc}</h2>
      {
        bascules.length > 0 ? (
          <>
            <p class="mt-2">
              Le CMG étant dégressif avec les revenus, le mode le moins cher change au fil du revenu
              du foyer. Avec les tarifs {loc} (couple, 1 enfant, {EX.heures} h/mois), les seuils
              de bascule sont les suivants :
            </p>
            <ul class="mt-3 flex flex-col gap-2">
              {bascules.map((b) => (
                <li class="card-brutal p-3">
                  <strong>À partir de {fmtEuro(b.revenu)}/mois</strong> de revenu net du foyer, «{" "}
                  {b.apres} » passe devant « {b.avant} ».
                </li>
              ))}
            </ul>
            <p class="mt-3">
              En dessous de {fmtEuro(bascules[0].revenu)}/mois, c'est donc «{" "}
              {bascules[0].avant} » qui reste le mode le moins cher {loc}. Ces seuils sont
              propres au département : ils dépendent des tarifs locaux, et diffèrent de ceux d'un
              département plus cher ou meilleur marché.
            </p>
          </>
        ) : (
          <p class="mt-2">
            Avec les tarifs {loc} et l'hypothèse retenue (couple, 1 enfant, {EX.heures} h/mois),
            le mode le moins cher reste « {gagnant.label} » sur toute la plage de revenus testée, de
            1 200 à 8 000 €/mois. Le nombre d'heures de garde et le nombre d'enfants peuvent en
            revanche modifier ce verdict : utilisez le comparateur pour votre cas.
          </p>
        )
      }
    </section>

    <div class="card-brutal bg-brutal-yellow p-4">
      <p class="text-sm font-bold">
        Ces chiffres sont un exemple. Votre revenu, vos heures et le nombre d'enfants changent le
        verdict.
      </p>
      <a
        href={cp ? `/?cp=${cp}` : "/"}
        class="btn-brutal mt-3 inline-block bg-background px-5 py-3 text-foreground"
      >
        → Calculer mon cas {loc}
      </a>
    </div>

    {
      villesDuDept.length > 0 && (
        <section>
          <h2 class="text-xl font-extrabold">Villes du département</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {villesDuDept.map((v) => (
              <li>
                <a
                  class="card-brutal-interactive block px-3 py-1.5 text-sm font-bold"
                  href={`/cout-garde-enfant/${slug}/${slugify(v.nom)}`}
                >
                  {v.nom} →
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section>
      <h2 class="text-xl font-extrabold">Départements aux tarifs comparables</h2>
      <p class="mt-1 text-sm leading-relaxed">
        Ces départements affichent un salaire horaire d'assistante maternelle proche de celui de {
          nom
        } — utile si vous hésitez entre plusieurs bassins de vie.
      </p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          comparables.map((d) => (
            <li>
              <a
                class="card-brutal-interactive block px-3 py-1.5 text-sm font-bold"
                href={`/cout-garde-enfant/${d.slug}`}
              >
                {d.nom} — {fmtEuro2(d.tauxHoraireAma)}/h →
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="text-sm leading-relaxed">
      <h2 class="text-xl font-extrabold">Questions fréquentes</h2>
      <h3 class="mt-3 font-bold">Combien coûte une assistante maternelle {loc} ?</h3>
      <p class="mt-1">
        Le salaire horaire net moyen d'une assistante maternelle {loc} est de
        {fmtEuro2(tarifs.tauxHoraireAma)}/h (URSSAF 2024), avant CMG et crédit d'impôt. Le reste à
        charge réel dépend de vos revenus et du nombre d'heures de garde.
      </p>
      <h3 class="mt-3 font-bold">Crèche ou nounou {loc} : lequel choisir ?</h3>
      <p class="mt-1">
        Au-delà du coût, la crèche n'est pas garantie (places limitées) et l'assistante maternelle
        offre plus de souplesse d'horaires. Côté budget, comparez le
        <a class="underline" href={cp ? `/?cp=${cp}` : "/"}>coût net réel pour votre situation</a>.
      </p>
      <h3 class="mt-3 font-bold">La garde d'enfant est-elle chère {loc} ?</h3>
      <p class="mt-1">
        {locCap}, le salaire horaire des assistantes maternelles se classe {fmtRang(rang)} sur {
          NB_DEPARTEMENTS
        }, à {fmtEuro2(tarifs.tauxHoraireAma)}/h net contre {fmtEuro2(MOYENNE_AMA)}/h en
        moyenne nationale (URSSAF 2024) — soit {positionTxt}{exAequoTxt}.
      </p>
    </section>

    <p class="text-xs text-muted-foreground">
      Sources : {SOURCE_TARIFS.source} ; barème CNAF 2026. Méthode détaillée sur la
      <a class="underline" href="/methodologie">page méthodologie</a>. Estimation indicative, pas un
      avis officiel.
    </p>
  </article>
</Layout>
