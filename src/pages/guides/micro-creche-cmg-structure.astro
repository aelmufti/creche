---
import Layout from "../../layouts/Layout.astro";
import Byline from "../../components/Byline.astro";
import { DATES } from "../../data/content-dates.mjs";
import { fmtEuro, fmtEuro2, fmtHeure } from "../../lib/format";
import { bareme, calcCreche, calcMicroCreche, comparer } from "../../engine";
import { seuilsMicroCreche } from "../../engine/calc";
import { inputsReference, TARIFS_REFERENCE } from "../../lib/scenario-reference";

const site = "https://creche-ou-nounou.fr";
const path = "/guides/micro-creche-cmg-structure";
const title = "Micro-crèche 2026 : CMG structure et reste à charge";
const m = bareme.micro_creche_structure;
const description = `Micro-crèche PAJE en 2026 : forfaits du CMG structure par tranche de revenus, plafond de ${fmtEuro(m.plafond_horaire)}/h et reste à charge chiffré.`;

// Tous les chiffres viennent du barème versionné (bareme-2026.json) et du moteur
// du comparateur : la page suit chaque mise à jour du barème.
const heures = inputsReference.heuresMois;
const tarif = TARIFS_REFERENCE.tarifMicroCreche;
const pct0 = (x: number) => `${Math.round(x * 100)} %`;
const fg = bareme.credit_impot.frais_garde;
const forfaits = m.forfait_max_mensuel_1enfant_moins3ans;
// Seuils annuels [T1, T2] par situation et nombre d'enfants à charge (service-public F345).
const [seuilT1, seuilT2] = seuilsMicroCreche(bareme, "couple", 1);
const [seuilIsoleT1, seuilIsoleT2] = seuilsMicroCreche(bareme, "isole", 1);
const nbEnfantsSeuils = [1, 2, 3, 4];
const lignesSeuils = nbEnfantsSeuils.map((n) => ({
  n,
  couple: seuilsMicroCreche(bareme, "couple", n),
  isole: seuilsMicroCreche(bareme, "isole", n),
}));
const pasCouple = m.seuils_revenus_annuels.couple.par_enfant_supplementaire;
const pasIsole = m.seuils_revenus_annuels.isole.par_enfant_supplementaire;
// Montants majorés de 30 % (parent isolé, AEEH) publiés par service-public.
const forfaitsMajores = m.montants_majores_30pct_moins3ans;

const revenus = [1500, 2000, 2500, 3000, 4000, 5000, 6000, 8500];
const lignes = revenus.map((r) => {
  const i = { ...inputsReference, revenuMensuelNet: r };
  const mc = calcMicroCreche(bareme, i);
  const cr = calcCreche(bareme, i);
  return {
    revenu: r,
    tranche: mc.details.tranche,
    forfait: mc.details.forfaitMax,
    cmg: mc.aide,
    reste: mc.tresorerieMensuelle,
    net: mc.netReel,
    netCreche: cr.netReel,
  };
});
const ex3000 = lignes.find((l) => l.revenu === 3000)!;
const ecarts = lignes.map((l) => l.net - l.netCreche);
const microToujoursPlusChere = ecarts.every((e) => e > 0);

// Effet du tarif horaire de la structure (foyer de référence).
const tarifs = [6, 8, 9, m.plafond_horaire, m.plafond_horaire + 0.5];
const lignesTarif = tarifs.map((t) => {
  const mc = calcMicroCreche(bareme, { ...inputsReference, tarifMicroCreche: t });
  return {
    t,
    cout: mc.coutBrut,
    cmg: mc.aide,
    reste: mc.tresorerieMensuelle,
    part: mc.tresorerieMensuelle / mc.coutBrut,
    net: mc.netReel,
  };
});

// Exemple pas à pas : 3 000 €/mois, 1 enfant de moins de 3 ans, tarif par défaut.
const ex = calcMicroCreche(bareme, inputsReference);
const coutTotal = ex.coutBrut;
const couverture = m.couverture_max * coutTotal;
const forfaitEx = ex.details.forfaitMax;
const resteMin = m.reste_a_charge_min * coutTotal;
const depensesAnnuelles = ex.tresorerieMensuelle * 12;
const depensesRetenues = Math.min(depensesAnnuelles, fg.plafond_par_enfant);
const ex3ans = calcMicroCreche(bareme, { ...inputsReference, agesGardes: [3] });
const exIsole = calcMicroCreche(bareme, { ...inputsReference, situation: "isole" });
const exAuDessus = lignesTarif[lignesTarif.length - 1];

const faq = [
  {
    q: "Combien coûte une micro-crèche en 2026 ?",
    a: `Le tarif horaire est libre. Au tarif de ${fmtHeure(tarif)} et pour ${heures} h de garde par mois, le coût total est de ${fmtEuro(coutTotal)}. Pour un foyer à 3 000 € de ressources mensuelles avec 1 enfant de moins de 3 ans, le CMG structure est de ${fmtEuro(ex.aide)}, le reste à charge de ${fmtEuro(ex.tresorerieMensuelle)} par mois et le coût net réel de ${fmtEuro(ex.netReel)} par mois après crédit d'impôt.`,
  },
  {
    q: "Comment fonctionne le CMG structure en micro-crèche ?",
    a: `En micro-crèche en tarification PAJE, le CMG structure couvre ${pct0(m.couverture_max)} du coût, dans la limite d'un forfait mensuel qui dépend de la tranche de revenus. Au 1er avril 2026, pour un enfant de moins de 3 ans et un couple avec 1 enfant, ce forfait est de ${fmtEuro2(forfaits.T1)}, ${fmtEuro2(forfaits.T2)} ou ${fmtEuro2(forfaits.T3)}. Le reste à charge ne peut pas être inférieur à ${pct0(m.reste_a_charge_min)} du coût.`,
  },
  {
    q: "Que se passe-t-il si la micro-crèche dépasse 10 €/h ?",
    a: `Au-dessus de ${fmtEuro(m.plafond_horaire)} de l'heure, le CMG structure n'est pas versé du tout. L'effet est brutal : à ${fmtHeure(exAuDessus.t)} au lieu de ${fmtHeure(m.plafond_horaire)}, le reste à charge d'un foyer à 3 000 € de ressources passe de ${fmtEuro(lignesTarif[3].reste)} à ${fmtEuro(exAuDessus.reste)} par mois pour ${heures} h de garde. Vérifiez le tarif horaire facturé avant de vous engager.`,
  },
  {
    q: "L'aide est-elle la même pour un enfant de 3 à 6 ans ?",
    a: `Non, le forfait maximum est divisé par deux pour un enfant de 3 à 6 ans (l'aide reste de 85 % du coût dans la limite de ce forfait réduit). Pour un foyer à 3 000 € de ressources mensuelles au tarif de ${fmtHeure(tarif)}, le CMG structure passe de ${fmtEuro(ex.aide)} à ${fmtEuro(ex3ans.aide)} par mois et le reste à charge de ${fmtEuro(ex.tresorerieMensuelle)} à ${fmtEuro(ex3ans.tresorerieMensuelle)} par mois, avant crédit d'impôt.`,
  },
  {
    q: "La réforme du CMG de septembre 2025 s'applique-t-elle à la micro-crèche ?",
    a: "Non. La réforme du 1er septembre 2025 concerne l'emploi direct (assistante maternelle, garde à domicile). Pour la micro-crèche structure, la logique forfaitaire est maintenue, ainsi que la division par deux du forfait maximum entre 3 et 6 ans et le reste à charge minimum de 15 %.",
  },
  {
    q: "Le crédit d'impôt s'applique-t-il en micro-crèche ?",
    a: `Oui : le reste à charge ouvre droit au crédit d'impôt frais de garde, soit ${pct0(fg.taux)} des dépenses dans la limite de ${fmtEuro(fg.plafond_par_enfant)} par enfant et par an. Dans l'exemple à 3 000 € de ressources, le crédit est de ${fmtEuro(ex.creditImpotAnnuel)} par an, ce qui ramène le coût de ${fmtEuro(ex.tresorerieMensuelle)} à ${fmtEuro(ex.netReel)} par mois.`,
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description,
    inLanguage: "fr-FR",
    datePublished: DATES.guides.published,
    dateModified: DATES.guides.modified,
    author: { "@type": "Person", name: "Ali El Mufti", url: "https://aelm.dev" },
    publisher: { "@type": "Organization", name: "creche-ou-nounou.fr", url: site },
    citation: ["https://www.pajemploi.urssaf.fr/", "https://www.service-public.fr/"],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: site + "/" },
      { "@type": "ListItem", position: 2, name: "Guides", item: site + "/guides" },
      { "@type": "ListItem", position: 3, name: "Micro-crèche", item: site + path },
    ],
  },
];
---

<Layout title={title} description={description} path={path} jsonLd={jsonLd} ogType="article" datePublished={DATES.guides.published} dateModified={DATES.guides.modified} ogImage={"/og/page-micro-creche-cmg-structure.png"}>
  <article class="mx-auto flex max-w-3xl flex-col gap-6">
    <nav aria-label="Fil d'Ariane" class="text-xs text-muted-foreground">
      <a class="underline" href="/">Accueil</a> › <a class="underline" href="/guides">Guides</a> › Micro-crèche
    </nav>
    <header>
      <h1 class="text-3xl font-extrabold sm:text-4xl">Micro-crèche 2026 : CMG structure et reste à charge</h1>
      <Byline modified={DATES.guides.modified} />
    </header>

    <div class="card-brutal border-l-[8px] border-l-brutal-green p-4 text-sm leading-relaxed">
      <p>
        <strong>En bref.</strong> Une micro-crèche en tarification PAJE ouvre droit au
        <strong>CMG « structure »</strong> : {pct0(m.couverture_max)} du coût, dans la limite d'un forfait
        selon vos revenus, tant que le tarif ne dépasse pas {fmtEuro(m.plafond_horaire)}/h. Au tarif de
        {" "}{fmtHeure(tarif)} et pour {heures} h de garde, un foyer à 3 000 € de ressources mensuelles
        avec 1 enfant de moins de 3 ans paie <strong>{fmtEuro(ex.tresorerieMensuelle)}/mois</strong> sur
        {" "}{fmtEuro(coutTotal)} de coût total, soit <strong>{fmtEuro(ex.netReel)}/mois</strong> après le
        crédit d'impôt de {pct0(fg.taux)}. Au-dessus de {fmtEuro(m.plafond_horaire)}/h, aucune aide.
      </p>
      <a href="/" class="btn-brutal mt-3 inline-block bg-brutal-yellow px-4 py-2 text-foreground">
        → Comparer micro-crèche et autres modes
      </a>
    </div>

    <section class="text-sm leading-relaxed" id="fonctionnement">
      <h2 class="text-xl font-extrabold">Comment se calcule l'aide</h2>
      <p class="mt-2">
        Contrairement à la crèche collective conventionnée (tarif au taux d'effort, voir le
        {" "}<a class="underline" href="/guides/tarif-creche-2026">tarif crèche 2026</a>), la micro-crèche en
        tarification PAJE fixe librement son prix horaire. La CAF verse en revanche le CMG structure
        (voir le <a class="underline" href="/glossaire">glossaire</a> : PAJE, CMG, micro-crèche), qui
        obéit à une logique de forfait, différente de l'emploi direct.
      </p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <li>
          <strong>Condition de tarif</strong> : {fmtEuro(m.plafond_horaire)} de l'heure au plus ; au-delà,
          le CMG n'est pas versé.
        </li>
        <li>
          <strong>Aide</strong> = {pct0(m.couverture_max)} du coût éligible, dans la limite du
          {" "}<strong>forfait de votre tranche</strong> de revenus (revenus de 2024).
        </li>
        <li>
          <strong>Reste à charge minimum</strong> : vous payez toujours au moins {pct0(m.reste_a_charge_min)}
          {" "}du coût éligible.
        </li>
        <li>
          <strong>Enfant de 3 à 6 ans</strong> : le forfait maximum est divisé par deux (l'aide reste de
          {" "}{pct0(m.couverture_max)} du coût dans la limite de ce forfait réduit).
        </li>
        <li>
          <strong>Durée minimale</strong> : au moins 16 h de garde par mois.
        </li>
      </ul>
    </section>

    <section id="forfaits">
      <h2 class="text-xl font-extrabold">Les trois tranches et leurs forfaits</h2>
      <p class="mt-2 text-sm leading-relaxed">
        Forfaits maximum au 1ᵉʳ avril 2026, pour un enfant de moins de 3 ans (couple avec 1 enfant).
        Les familles monoparentales, celles qui perçoivent l'AEEH et les bénéficiaires de l'AAH ont des
        montants majorés de 30 % ; les seuils de revenus majorés ne concernent que le parent isolé.
        Montants nets de CRDS, tels que versés aux familles (service-public.gouv.fr).
      </p>
      <div class="mt-3 overflow-x-auto">
        <table class="card-brutal w-full text-sm">
          <caption class="sr-only">Forfaits mensuels maximum du CMG structure en micro-crèche au 1er avril 2026, par tranche de revenus annuels, pour un couple et pour un parent isolé</caption>
          <thead>
            <tr class="border-b-[3px] border-border text-left">
              <th scope="col" class="p-2">Tranche</th>
              <th scope="col" class="p-2">Revenus annuels (couple)</th>
              <th scope="col" class="p-2">Forfait max (couple)</th>
              <th scope="col" class="p-2">Revenus annuels (parent isolé)</th>
              <th scope="col" class="p-2">Forfait max majoré (parent isolé, AEEH)</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-t border-border/30">
              <th scope="row" class="p-2 text-left font-bold">Tranche 1</th>
              <td class="p-2">jusqu'à {fmtEuro(seuilT1)}</td>
              <td class="p-2">{fmtEuro2(forfaits.T1)}</td>
              <td class="p-2">jusqu'à {fmtEuro(seuilIsoleT1)}</td>
              <td class="p-2">{fmtEuro2(forfaitsMajores.T1)}</td>
            </tr>
            <tr class="border-t border-border/30">
              <th scope="row" class="p-2 text-left font-bold">Tranche 2</th>
              <td class="p-2">jusqu'à {fmtEuro(seuilT2)}</td>
              <td class="p-2">{fmtEuro2(forfaits.T2)}</td>
              <td class="p-2">jusqu'à {fmtEuro(seuilIsoleT2)}</td>
              <td class="p-2">{fmtEuro2(forfaitsMajores.T2)}</td>
            </tr>
            <tr class="border-t border-border/30">
              <th scope="row" class="p-2 text-left font-bold">Tranche 3</th>
              <td class="p-2">au-delà de {fmtEuro(seuilT2)}</td>
              <td class="p-2">{fmtEuro2(forfaits.T3)}</td>
              <td class="p-2">au-delà de {fmtEuro(seuilIsoleT2)}</td>
              <td class="p-2">{fmtEuro2(forfaitsMajores.T3)}</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-xs text-muted-foreground">
        Ce premier tableau donne les seuils d'un foyer avec 1 enfant à charge. Ils augmentent avec le
        nombre d'enfants à charge (tableau ci-dessous). Voir la
        {" "}<a class="underline" href="/methodologie">méthodologie</a>.
      </p>
      <h3 class="mt-4 font-bold">Seuils de revenus selon le nombre d'enfants à charge</h3>
      <div class="mt-2 overflow-x-auto">
        <table class="card-brutal w-full text-sm">
          <caption class="sr-only">Seuils annuels de revenus des tranches 1 et 2 du CMG structure en micro-crèche, selon le nombre d'enfants à charge, pour un couple et pour un parent isolé</caption>
          <thead>
            <tr class="border-b-[3px] border-border text-left">
              <th scope="col" class="p-2">Enfants à charge</th>
              <th scope="col" class="p-2">Couple : tranche 1 jusqu'à</th>
              <th scope="col" class="p-2">Couple : tranche 2 jusqu'à</th>
              <th scope="col" class="p-2">Parent isolé : tranche 1 jusqu'à</th>
              <th scope="col" class="p-2">Parent isolé : tranche 2 jusqu'à</th>
            </tr>
          </thead>
          <tbody>
            {
              lignesSeuils.map((l) => (
                <tr class="border-t border-border/30">
                  <th scope="row" class="p-2 text-left font-bold">{l.n}</th>
                  <td class="p-2">{fmtEuro(l.couple[0])}</td>
                  <td class="p-2">{fmtEuro(l.couple[1])}</td>
                  <td class="p-2">{fmtEuro(l.isole[0])}</td>
                  <td class="p-2">{fmtEuro(l.isole[1])}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-xs text-muted-foreground">
        Au-delà de 4 enfants, chaque enfant supplémentaire ajoute {fmtEuro(pasCouple[0])} et
        {" "}{fmtEuro(pasCouple[1])} aux seuils d'un couple, {fmtEuro(pasIsole[0])} et {fmtEuro(pasIsole[1])}
        {" "}à ceux d'un parent isolé. Revenus nets catégoriels de 2024.
      </p>
    </section>

    <section id="cout-par-revenu">
      <h2 class="text-xl font-extrabold">Reste à charge en micro-crèche selon vos revenus</h2>
      <p class="mt-2 text-sm leading-relaxed">
        Le tableau applique les règles ci-dessus au tarif de {fmtHeure(tarif)} (valeur par défaut du
        comparateur) et rapproche le coût net réel de celui d'une crèche collective au tarif PSU.
      </p>
      <div class="mt-3 overflow-x-auto">
        <table class="card-brutal w-full text-sm">
          <caption class="sr-only">Coût d'une micro-crèche à 10 € de l'heure en 2026 par niveau de ressources mensuelles : tranche, forfait, CMG structure, reste à charge, coût net réel et comparaison avec la crèche collective</caption>
          <thead>
            <tr class="border-b-[3px] border-border text-left">
              <th scope="col" class="p-2">Ressources / mois</th>
              <th scope="col" class="p-2">Tranche</th>
              <th scope="col" class="p-2">CMG structure</th>
              <th scope="col" class="p-2">Reste à charge</th>
              <th scope="col" class="p-2">Net réel après crédit</th>
              <th scope="col" class="p-2">Crèche collective (net réel)</th>
            </tr>
          </thead>
          <tbody>
            {
              lignes.map((l) => (
                <tr class="border-t border-border/30">
                  <th scope="row" class="p-2 text-left font-bold">{fmtEuro(l.revenu)}</th>
                  <td class="p-2">
                    {l.tranche} <span class="text-muted-foreground">(forfait {fmtEuro2(l.forfait)})</span>
                  </td>
                  <td class="p-2">{fmtEuro(l.cmg)}</td>
                  <td class="p-2">{fmtEuro(l.reste)}</td>
                  <td class="p-2 font-bold">{fmtEuro(l.net)}/mois</td>
                  <td class="p-2">{fmtEuro(l.netCreche)}/mois</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-xs text-muted-foreground">
        Hypothèses : 1 enfant de moins de 3 ans, couple, {heures} h par mois, tarif de {fmtHeure(tarif)},
        coût total de {fmtEuro(coutTotal)}/mois, aucune participation d'employeur. Le revenu annuel
        est estimé en multipliant les ressources mensuelles par 12.
      </p>
      <p class="mt-3 text-sm leading-relaxed">
        <strong>Lecture.</strong>
        {
          microToujoursPlusChere
            ? `Sur ces hypothèses, la micro-crèche coûte de ${fmtEuro(Math.min(...ecarts))} à ${fmtEuro(Math.max(...ecarts))} de plus par mois que la crèche collective selon les revenus. Son intérêt est ailleurs : souvent plus de disponibilité et des horaires plus souples, alors qu'une place en crèche collective n'est jamais garantie.`
            : "Selon les revenus, la micro-crèche peut coûter autant ou moins qu'une crèche collective ; comparez avec votre situation."
        }
        Comparez aussi avec l'<a class="underline" href="/guides/creche-ou-assistante-maternelle">assistante maternelle</a>.
      </p>
    </section>

    <section class="text-sm leading-relaxed" id="exemple">
      <h2 class="text-xl font-extrabold">Exemple pas à pas : 3 000 € de ressources, 1 enfant</h2>
      <p class="mt-2">
        Couple, 1 enfant de moins de 3 ans, {heures} h de garde par mois, tarif de {fmtHeure(tarif)}.
      </p>
      <ol class="mt-3 list-decimal space-y-2 pl-5">
        <li>
          <strong>Coût total</strong> : {heures} h × {fmtHeure(tarif)} = <strong>{fmtEuro(coutTotal)}</strong> par mois.
        </li>
        <li>
          <strong>Tranche</strong> : {fmtEuro(inputsReference.revenuMensuelNet * 12)} de revenus annuels
          estimés, soit la tranche {ex.details.tranche} : forfait maximum de <strong>{fmtEuro2(forfaitEx)}</strong>.
        </li>
        <li>
          <strong>CMG structure</strong> : {pct0(m.couverture_max)} de {fmtEuro(coutTotal)} = {fmtEuro(couverture)},
          limité au forfait de {fmtEuro2(forfaitEx)} : <strong>{fmtEuro(ex.aide)}</strong>.
        </li>
        <li>
          <strong>Reste à charge</strong> : {fmtEuro(coutTotal)} − {fmtEuro(ex.aide)} =
          {" "}<strong>{fmtEuro(ex.tresorerieMensuelle)}</strong> par mois (le minimum de {pct0(m.reste_a_charge_min)}
          {" "}serait de {fmtEuro(resteMin)} : il n'est pas atteint ici).
        </li>
        <li>
          <strong>Crédit d'impôt frais de garde</strong> : {pct0(fg.taux)} des dépenses, retenues jusqu'à
          {" "}{fmtEuro(fg.plafond_par_enfant)} par enfant et par an ({fmtEuro(depensesAnnuelles)} de dépenses,
          {" "}{fmtEuro(depensesRetenues)} retenus) = <strong>{fmtEuro(ex.creditImpotAnnuel)}</strong> par an, soit
          {" "}{fmtEuro(ex.creditImpotMensuel)} par mois.
        </li>
        <li>
          <strong>Coût net réel</strong> : {fmtEuro(ex.tresorerieMensuelle)} − {fmtEuro(ex.creditImpotMensuel)} =
          {" "}<strong>{fmtEuro(ex.netReel)}</strong> par mois.
        </li>
      </ol>
      <p class="mt-3">
        <strong>Variantes.</strong> Pour un enfant de 3 à 6 ans, le forfait maximum est divisé par deux :
        {" "}{fmtEuro(ex3ans.aide)} de CMG et {fmtEuro(ex3ans.tresorerieMensuelle)} de reste à charge.
        Pour un parent isolé à ressources égales, le forfait applicable est de
        {" "}{fmtEuro(exIsole.details.forfaitMax)} (tranche {exIsole.details.tranche}) : CMG de
        {" "}{fmtEuro(exIsole.aide)} et reste à charge de {fmtEuro(exIsole.tresorerieMensuelle)}.
      </p>
    </section>

    <section id="tarif-horaire">
      <h2 class="text-xl font-extrabold">L'effet du tarif horaire : attention au seuil</h2>
      <p class="mt-2 text-sm leading-relaxed">
        Le tarif horaire est fixé par la structure. Tant qu'il reste à {fmtEuro(m.plafond_horaire)}/h ou
        moins, l'aide s'applique ; au-delà, elle disparaît. Simulation pour un foyer à 3 000 € de
        ressources mensuelles, 1 enfant de moins de 3 ans, {heures} h par mois :
      </p>
      <div class="mt-3 overflow-x-auto">
        <table class="card-brutal w-full text-sm">
          <caption class="sr-only">Effet du tarif horaire de la micro-crèche sur le CMG structure, le reste à charge et le coût net réel, pour un foyer à 3 000 € de ressources mensuelles</caption>
          <thead>
            <tr class="border-b-[3px] border-border text-left">
              <th scope="col" class="p-2">Tarif horaire</th>
              <th scope="col" class="p-2">Coût total</th>
              <th scope="col" class="p-2">CMG structure</th>
              <th scope="col" class="p-2">Reste à charge</th>
              <th scope="col" class="p-2">Part du coût payée</th>
              <th scope="col" class="p-2">Net réel après crédit</th>
            </tr>
          </thead>
          <tbody>
            {
              lignesTarif.map((l) => (
                <tr class="border-t border-border/30">
                  <th scope="row" class="p-2 text-left font-bold">{fmtHeure(l.t)}</th>
                  <td class="p-2">{fmtEuro(l.cout)}</td>
                  <td class="p-2">{fmtEuro(l.cmg)}</td>
                  <td class="p-2">{fmtEuro(l.reste)}</td>
                  <td class="p-2">{pct0(l.part)}</td>
                  <td class="p-2 font-bold">{fmtEuro(l.net)}/mois</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-xs text-muted-foreground">
        À bas tarif, l'aide plafonne à {pct0(m.couverture_max)} du coût : la part payée est alors de
        {" "}{pct0(m.reste_a_charge_min)}. À {fmtHeure(m.plafond_horaire + 0.5)}, le CMG tombe à {fmtEuro(exAuDessus.cmg)}.
      </p>
    </section>

    <section class="text-sm leading-relaxed" id="pieges">
      <h2 class="text-xl font-extrabold">Limites et pièges à connaître</h2>
      <ul class="mt-2 list-disc space-y-2 pl-5">
        <li>
          <strong>Le seuil de {fmtEuro(m.plafond_horaire)}/h est binaire.</strong> Un tarif à
          {" "}{fmtHeure(m.plafond_horaire + 0.5)} coûte {fmtEuro(exAuDessus.reste - lignesTarif[3].reste)} de plus par mois, dans l'exemple,
          qu'un tarif à {fmtHeure(m.plafond_horaire)}, bien au-delà de l'écart de 50 centimes.
        </li>
        <li>
          <strong>Trésorerie contre coût net.</strong> Le coût net est calculé après crédit d'impôt, qui
          est obtenu ensuite : ce qui sort chaque mois du compte est le reste à charge
          ({fmtEuro(ex.tresorerieMensuelle)} dans l'exemple). Voir le guide
          {" "}<a class="underline" href="/guides/credit-impot-frais-de-garde">crédit d'impôt frais de garde</a>.
        </li>
        <li>
          <strong>Majorations non cumulées.</strong> Le comparateur applique une seule majoration de
          30 % (parent isolé ou AEEH) ; le cumul des majorations et le +10 % pour horaires atypiques ne
          sont pas modélisés : estimation prudente de l'aide.
        </li>
        <li>
          <strong>Pas de réforme de 2025 ici.</strong> La réforme du CMG de septembre 2025 ne concerne
          que l'emploi direct ; voir le guide
          {" "}<a class="underline" href="/guides/reforme-cmg-septembre-2025">réforme du CMG</a> et le
          {" "}<a class="underline" href="/guides/cmg-2026">guide CMG 2026</a>.
        </li>
        <li>
          <strong>Tarif local.</strong> Le tarif des micro-crèches varie : le comparateur retient
          {" "}{fmtHeure(tarif)} par défaut, à remplacer par le tarif réel de la structure.
        </li>
      </ul>
    </section>

    <section class="text-sm leading-relaxed" id="comparaison">
      <h2 class="text-xl font-extrabold">Micro-crèche ou crèche collective ?</h2>
      <p class="mt-2">
        La <strong>crèche collective (PSU)</strong> applique un tarif au taux d'effort, très avantageux
        pour les revenus modestes. La <strong>micro-crèche (PAJE)</strong> revient plus cher sur nos
        hypothèses, mais elle est souvent plus disponible. Si vous avez le choix, comparez le coût net
        réel des deux pour votre situation : <a class="underline" href="/">lancez le comparateur</a>.
      </p>
    </section>

    <section class="text-sm leading-relaxed" id="faq">
      <h2 class="text-xl font-extrabold">Questions fréquentes</h2>
      {
        faq.map((f) => (
          <>
            <h3 class="mt-3 font-bold">{f.q}</h3>
            <p class="mt-1">{f.a}</p>
          </>
        ))
      }
    </section>

