---
import Layout from "../../layouts/Layout.astro";
import { DATES } from "../../data/content-dates.mjs";
import { fmtDateFr } from "../../lib/format";

const site = "https://creche-ou-nounou.fr";
const path = "/guides/creche-ou-assistante-maternelle";
const title = "Crèche ou assistante maternelle : le moins cher en 2026";
const description =
  "Crèche ou assistante maternelle : coût réel, CMG, crédit d'impôt et souplesse comparés au barème 2026. Le bon choix selon vos revenus et vos heures.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description,
    inLanguage: "fr-FR",
    datePublished: DATES.guides.published,
    dateModified: DATES.guides.modified,
    author: { "@type": "Person", name: "Ali El Mufti", url: "https://aelm.dev" },
    publisher: { "@type": "Organization", name: "creche-ou-nounou.fr", url: site },
    citation: [
      "https://www.service-public.fr/particuliers/vosdroits/F345",
      "https://www.caf.fr/",
      "https://www.pajemploi.urssaf.fr/",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "La crèche est-elle moins chère qu'une assistante maternelle ?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Pas forcément. Depuis la réforme du CMG du 1er septembre 2025, une assistante maternelle payée au coût horaire de référence (4,91 € au 1er avril 2026, indemnités d'entretien et de repas comprises) laisse le même reste à charge qu'une crèche collective, quels que soient vos revenus. Si elle coûte moins cher de l'heure, elle revient moins cher que la crèche ; si elle coûte plus cher, la crèche l'emporte. Le crédit d'impôt de 50 % s'applique aux deux.",
        },
      },
      {
        "@type": "Question",
        name: "Quelle aide pour une assistante maternelle en 2026 ?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Le CMG (Complément de libre choix du mode de garde) prend en charge une partie du salaire et des indemnités d'entretien et de repas, et la totalité des cotisations sociales. Depuis le 1er septembre 2025, le CMG en emploi direct est proportionnel au reste à charge. S'ajoute un crédit d'impôt de 50 % des frais de garde, dans la limite de 3 500 € par enfant.",
        },
      },
      {
        "@type": "Question",
        name: "Y a-t-il une aide pour la crèche ?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "En crèche collective conventionnée (PSU), il n'y a pas de CMG : l'aide est déjà intégrée dans le tarif horaire, calculé selon vos revenus et le nombre d'enfants à charge (taux d'effort CNAF). Le reste à charge ouvre droit au crédit d'impôt frais de garde (50 %, plafond 3 500 €/enfant).",
        },
      },
    ],
  },
  // HowTo (§4.2) : reprend mot pour mot les 5 étapes visibles de la section
  // « Comment savoir laquelle est la moins chère pour vous ». Baliser des étapes
  // absentes de la page serait du markup trompeur.
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Comment choisir entre crèche et assistante maternelle",
    description:
      "Cinq étapes pour déterminer, chiffres à l'appui, lequel des deux modes de garde coûte le moins cher dans votre situation.",
    inLanguage: "fr-FR",
    totalTime: "PT5M",
    url: site + path + "#etapes",
    step: [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Calculer le coût horaire de l'assistante maternelle",
        text: "Salaire net plus indemnités d'entretien et de repas, divisés par le nombre d'heures. Comparé au coût de référence de 4,91 €/h (1er avril 2026), c'est la variable qui fait basculer le verdict : en dessous, l'assistante maternelle revient moins cher que la crèche ; au-dessus, plus cher.",
        url: site + path + "#etapes",
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Estimer vos heures et votre revenu net mensuel",
        text: "Heures = amplitude hebdomadaire × semaines travaillées ÷ 12. Le revenu du foyer fixe le tarif de la crèche et le CMG de la même façon : il pèse sur le budget, mais change peu l'écart entre les deux modes.",
        url: site + path + "#etapes",
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Utiliser les tarifs de votre département",
        text: "Le salaire horaire des assistantes maternelles varie d'un département à l'autre (données URSSAF) : renseigner son code postal évite de raisonner sur une moyenne nationale.",
        url: site + path + "#etapes",
      },
      {
        "@type": "HowToStep",
        position: 4,
        name: "Comparer le coût net réel, pas le tarif horaire",
        text: "Le seul chiffre comparable entre modes de garde est le coût net réel mensuel, après CMG et après crédit d'impôt de 50 %.",
        url: site + path + "#etapes",
      },
      {
        "@type": "HowToStep",
        position: 5,
        name: "Vérifier la disponibilité avant de trancher",
        text: "Une place en crèche n'est jamais garantie. Si l'écart de budget est faible, la disponibilité et la souplesse d'horaires décident à la place du prix.",
        url: site + path + "#etapes",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: site + "/" },
      { "@type": "ListItem", position: 2, name: "Crèche ou assistante maternelle", item: site + path },
    ],
  },
];

const criteres = [
  ["Prix", "Tarif au taux d'effort CNAF, selon vos revenus", "Même reste à charge qu'en crèche si l'AMA coûte 4,91 €/h ; moins si elle coûte moins, plus sinon"],
  ["Revenus élevés", "Tarif plafonné (5,26 €/h pour 1 enfant)", "Coût horaire aidé jusqu'à 8,09 €/h, l'excédent reste à votre charge"],
  ["Disponibilité", "Places limitées, non garantie", "Plus de disponibilité selon le secteur"],
  ["Souplesse d'horaires", "Horaires fixes de la structure", "Souple (négociée avec l'AMA)"],
  ["Démarches", "Aucune (la crèche gère)", "Vous êtes employeur (contrat, Pajemploi)"],
  ["Crédit d'impôt", "50 %, plafond 3 500 €/enfant", "50 %, plafond 3 500 €/enfant"],
];
---

<Layout title={title} description={description} path={path} jsonLd={jsonLd} ogType="article" datePublished={DATES.guides.published} dateModified={DATES.guides.modified} ogImage={"/og/page-creche-ou-assistante-maternelle.png"}>
  <article class="mx-auto flex max-w-3xl flex-col gap-6">
    <nav aria-label="Fil d'Ariane" class="text-xs text-muted-foreground">
      <a class="underline" href="/">Accueil</a> › Crèche ou assistante maternelle
    </nav>

    <header>
      <h1 class="text-3xl font-extrabold sm:text-4xl">
        Crèche ou assistante maternelle : laquelle coûte le moins cher en 2026 ?
      </h1>
      <p class="mt-2 text-xs text-muted-foreground">Mis à jour le {fmtDateFr(DATES.guides.modified)}.</p>
    </header>

    <div class="card-brutal border-l-[8px] border-l-brutal-blue p-4 text-sm leading-relaxed">
      <p>
        <strong>En bref.</strong> Depuis la réforme du CMG du 1ᵉʳ septembre 2025, les deux modes
        coûtent presque la même chose. Une <strong>assistante maternelle</strong> payée au coût de
        référence (4,91 €/h au 1ᵉʳ avril 2026, indemnités comprises) laisse <strong>le même reste
        à charge qu'une crèche collective</strong>, quels que soient vos revenus. Moins chère de
        l'heure, elle revient moins cher que la crèche ; plus chère, c'est la crèche qui l'emporte.
        Le crédit d'impôt de 50 % s'applique aux deux. Le verdict dépend donc surtout du tarif de
        l'assistante maternelle, et de la place disponible en crèche.
      </p>
      <a href="/" class="btn-brutal mt-3 inline-block bg-brutal-yellow px-4 py-2 text-foreground">
        → Comparer pour ma situation
      </a>
    </div>

    <section class="text-sm leading-relaxed">
      <h2 class="text-xl font-extrabold">Deux mécanismes, un même objectif</h2>
      <p class="mt-2">
        La <strong>crèche collective</strong> conventionnée applique la
        <em>Prestation de service unique</em> (PSU) : vous ne touchez pas le CMG, mais le tarif horaire
        est directement calculé selon vos ressources et votre nombre d'enfants à charge
        (<a class="underline" href="/guides/tarif-creche-2026">détail du tarif crèche 2026</a>). Résultat : un
        tarif très bas pour les revenus modestes, plafonné autour de 5 €/h pour les hauts revenus.
      </p>
      <p class="mt-2">
        L'<strong>assistante maternelle agréée</strong> en emploi direct fonctionne à l'inverse : vous
        payez un salaire horaire et des indemnités, puis le <strong>CMG</strong> rembourse une partie
        de ce coût et la totalité des cotisations sociales. Depuis le 1ᵉʳ septembre 2025, ce CMG
        applique le <strong>même taux d'effort qu'en crèche</strong>, rapporté à un coût horaire de
        référence : c'est ce qui aligne les deux restes à charge. S'ajoute le crédit d'impôt de 50 %.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-extrabold">Comparatif crèche vs assistante maternelle</h2>
      <table class="card-brutal mt-3 w-full text-sm">
        <thead>
          <tr class="border-b-[3px] border-border text-left">
            <th class="p-2">Critère</th>
            <th class="p-2">Crèche collective</th>
            <th class="p-2">Assistante maternelle</th>
          </tr>
        </thead>
        <tbody>
          {
            criteres.map(([c, creche, ama]) => (
              <tr class="border-t border-border/30 align-top">
                <td class="p-2 font-bold">{c}</td>
                <td class="p-2">{creche}</td>
                <td class="p-2">{ama}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="text-sm leading-relaxed">
      <h2 class="text-xl font-extrabold">Comment savoir laquelle est la moins chère pour vous</h2>
      <p class="mt-2">
        Une variable fait basculer le verdict : le <strong>coût horaire de l'assistante
        maternelle</strong> comparé au coût de référence de 4,91 €. Vos <strong>revenus</strong> et
        le <strong>nombre d'heures</strong> fixent le budget des deux modes de la même façon, et les
        <strong>tarifs locaux</strong> des assistantes maternelles varient selon le département.
        Le comparateur calcule le <strong>coût net réel</strong> des deux options — après CMG et crédit
        d'impôt — pour votre cas précis.
      </p>
      <ol class="mt-3 list-decimal space-y-2 pl-5" id="etapes">
        <li>
          <strong>Calculez le coût horaire de l'assistante maternelle</strong> : salaire net plus
          indemnités d'entretien et de repas, divisés par le nombre d'heures. Comparé au coût de
          référence de 4,91 €/h (1ᵉʳ avril 2026), c'est la variable qui fait basculer le verdict :
          en dessous, l'assistante maternelle revient moins cher que la crèche ; au-dessus, plus cher.
        </li>
        <li>
          <strong>Estimez vos heures et votre revenu net mensuel</strong> — heures = amplitude
          hebdomadaire × semaines travaillées ÷ 12. Le revenu du foyer fixe le tarif de la crèche et
          le CMG de la même façon : il pèse sur le budget, mais change peu l'écart entre les deux
          modes.
        </li>
        <li>
          <strong>Renseignez votre code postal</strong> pour utiliser le salaire horaire réel des
          assistantes maternelles de votre département (URSSAF) plutôt qu'une moyenne nationale —
          voir le <a class="underline" href="/cout-garde-enfant">coût par département</a>.
        </li>
        <li>
          <strong>Comparez le coût net réel</strong>, après CMG et crédit d'impôt, et pas le tarif
          horaire affiché : <a class="underline" href="/">lancez le comparateur</a> (instantané, sans
          inscription). La <a class="underline" href="/methodologie">méthode et les sources</a> sont
          publiques.
        </li>
        <li>
          <strong>Vérifiez la disponibilité avant de trancher</strong> : une place en crèche n'est
          jamais garantie. Si l'écart de budget est faible, la disponibilité et la souplesse
          d'horaires décident à la place du prix.
        </li>
      </ol>
    </section>

    <section class="text-sm leading-relaxed">
      <h2 class="text-xl font-extrabold">Questions fréquentes</h2>
      <h3 class="mt-3 font-bold">La crèche est-elle moins chère qu'une assistante maternelle ?</h3>
      <p class="mt-1">
        Pas forcément. Depuis la réforme du CMG du 1er septembre 2025, une assistante maternelle payée au coût horaire de référence (4,91 € au 1er avril 2026, indemnités d'entretien et de repas comprises) laisse le même reste à charge qu'une crèche collective, quels que soient vos revenus. Si elle coûte moins cher de l'heure, elle revient moins cher que la crèche ; si elle coûte plus cher, la crèche l'emporte. Le crédit d'impôt de 50 % s'applique aux deux.
      </p>
      <h3 class="mt-3 font-bold">Quelle aide pour une assistante maternelle en 2026 ?</h3>
      <p class="mt-1">
        Le CMG prend en charge une partie du salaire et des indemnités, et 100 % des cotisations,
        auquel s'ajoute le
        crédit d'impôt frais de garde (50 %, plafond 3 500 €/enfant). Le CMG emploi direct est
        proportionnel au reste à charge depuis septembre 2025.
      </p>
    </section>

    <p class="text-xs text-muted-foreground">
      Sources : service-public.fr, CAF, URSSAF/Pajemploi (2026). Estimation indicative, pas un avis
      officiel — vérifiez sur caf.fr.
    </p>
  </article>
</Layout>
