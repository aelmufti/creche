---
import Layout from "../layouts/Layout.astro";
const title = "Page introuvable (404) — creche-ou-nounou.fr";
const description = "Cette page n'existe pas. Revenez au comparateur des modes de garde.";
---

<Layout title={title} description={description} path="/404">
  <div class="mx-auto flex max-w-2xl flex-col items-start gap-5 py-10">
    <p class="text-6xl font-extrabold">404</p>
    <h1 class="text-2xl font-extrabold">Cette page n'existe pas.</h1>
    <p class="text-muted-foreground">
      Le lien est peut-être erroné ou la page a été déplacée. Voici par où continuer :
    </p>
    <nav aria-label="Liens utiles" class="flex flex-wrap gap-3">
      <a href="/" class="btn-brutal bg-brutal-yellow px-4 py-2 text-foreground">→ Le comparateur</a>
      <a href="/guides" class="btn-brutal bg-card px-4 py-2">Guides</a>
      <a href="/cout-garde-enfant" class="btn-brutal bg-card px-4 py-2">Coût par département</a>
    </nav>
  </div>
</Layout>
