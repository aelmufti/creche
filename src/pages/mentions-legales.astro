---
import Layout from "../layouts/Layout.astro";
const title = "Mentions légales — creche-ou-nounou.fr";
const description =
  "Mentions légales du comparateur creche-ou-nounou.fr : éditeur, hébergement, responsabilité.";
---

<Layout title={title} description={description} path="/mentions-legales">
  <article class="mx-auto flex max-w-3xl flex-col gap-4">
    <h1 class="text-3xl font-extrabold sm:text-4xl">Mentions légales</h1>
    <section class="card-brutal p-4 text-sm leading-relaxed">
      <h2 class="font-extrabold uppercase tracking-brutal">Éditeur</h2>
      <p class="mt-1">
        Site édité par Ali El Mufti — <a class="underline" href="https://aelm.dev">aelm.dev</a>.
        Contact : via aelm.dev.
      </p>
    </section>
    <section class="card-brutal p-4 text-sm leading-relaxed">
      <h2 class="font-extrabold uppercase tracking-brutal">Hébergement</h2>
      <p class="mt-1">
        Site statique hébergé chez un fournisseur d'hébergement web (à compléter avant mise en
        production).
      </p>
    </section>
    <section class="card-brutal p-4 text-sm leading-relaxed">
      <h2 class="font-extrabold uppercase tracking-brutal">Responsabilité</h2>
      <p class="mt-1">
        Les résultats sont des estimations indicatives fondées sur des barèmes publics. Ils ne
        constituent ni un avis officiel, ni un engagement de la CAF, de l'Urssaf/Pajemploi ou de
        l'administration fiscale. Vérifiez votre situation sur les sites officiels.
      </p>
    </section>
  </article>
</Layout>
