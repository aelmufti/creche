---
import Layout from "../layouts/Layout.astro";
import { Calculator } from "../components/Calculator";
import { comparer, inputsParDefaut } from "../engine";
import { fmtEuro } from "../lib/format";
import { ORGANIZATION, PERSON, WEBSITE, ORG_ID } from "../lib/schema";

const site = "https://creche-ou-nounou.fr";
const title = "Crèche ou nounou ? Comparateur de coût 2026";
const description =
  "Crèche, assistante maternelle ou garde à domicile : trouvez le mode de garde le moins cher. Verdict chiffré au barème 2026, gratuit, sans inscription.";

// Réponse directe citable (answer-first) : calculée au build par le moteur, au
// scénario par défaut du comparateur — le chiffre suit donc le barème.
const exemple = comparer(inputsParDefaut);
const [premier, second] = exemple.classement;
// Article défini devant le libellé du mode (« la crèche », « l'assistante… »).
const avecArticle = (label: string) =>
  /^[aeéiou]/i.test(label) ? `l'${label.toLowerCase()}` : `la ${label.toLowerCase()}`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Comparateur crèche ou nounou",
    url: site + "/",
    applicationCategory: "FinanceApplication",
    operatingSystem: "Web",
    inLanguage: "fr-FR",
    offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
    description,
    isAccessibleForFree: true,
    featureList: [
      "Comparaison de 5 modes de garde (crèche, micro-crèche, assistante maternelle, garde à domicile, garde partagée)",
      "CMG 2026 après la réforme du 1er septembre 2025",
      "Crédit d'impôt frais de garde et emploi à domicile",
      "Tarifs locaux par département (URSSAF)",
      "Sans inscription, calcul dans le navigateur",
    ],
    creator: { "@id": PERSON["@id"] },
    publisher: { "@id": ORG_ID },
  },
  { "@context": "https://schema.org", ...WEBSITE },
  { "@context": "https://schema.org", ...ORGANIZATION },
  { "@context": "https://schema.org", ...PERSON },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "Crèche ou nounou : qu'est-ce qui coûte le moins cher ?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Cela dépend de vos revenus, du nombre d'enfants à charge, des heures de garde et des tarifs locaux. La crèche collective applique un tarif au taux d'effort CNAF ; depuis la réforme de septembre 2025, une assistante maternelle payée au coût de référence (4,91 €/h) laisse le même reste à charge grâce au CMG ; la garde à domicile bénéficie d'un crédit d'impôt plus élevé. Le comparateur calcule le coût net réel de chaque mode pour votre situation.",
        },
      },
      {
        "@type": "Question",
        name: "Le calcul tient-il compte de la réforme du CMG de septembre 2025 ?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Oui. Depuis le 1ᵉʳ septembre 2025, le Complément de libre choix du mode de garde (CMG) en emploi direct est proportionnel au reste à charge. Le comparateur applique ce nouveau mode de calcul.",
        },
      },
      {
        "@type": "Question",
        name: "Faut-il créer un compte pour obtenir le résultat ?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Non. Le résultat est instantané et gratuit, sans inscription. Tout est calculé dans votre navigateur ; votre scénario est sauvegardé dans l'adresse de la page.",
        },
      },
    ],
  },
];
---

<Layout title={title} description={description} path="/" jsonLd={jsonLd}>
  <div class="flex flex-col gap-8">
    <section class="hero-grid-bg -mx-5 border-b-[3px] border-border px-5 pb-8 pt-2">
      <h1 class="max-w-3xl text-4xl font-extrabold leading-[1.05] sm:text-5xl">
        Crèche ou nounou ? <span class="marker">Le moins cher</span> pour votre famille.
      </h1>
      <p class="mt-4 max-w-2xl text-base text-muted-foreground">
        Comparez crèche, micro-crèche, assistante maternelle, garde à domicile et garde partagée.
        Verdict chiffré personnalisé au barème 2026 (CMG, crédit d'impôt, reste à charge).
        Instantané, gratuit, <strong class="text-foreground">sans inscription</strong>.
      </p>
      <div class="mt-4 flex flex-wrap gap-2 text-xs font-bold uppercase tracking-brutal">
        {
          ["Réforme CMG sept. 2025", "Trésorerie vs coût net réel", "Tarifs locaux URSSAF"].map(
            (t) => (
              <span class="border-[3px] border-border bg-card px-2 py-1 shadow-brutal-sm">{t}</span>
            ),
          )
        }
      </div>
    </section>

    <p class="card-brutal border-l-[8px] border-l-brutal-blue p-4 text-sm leading-relaxed">
      <strong>En bref.</strong> Pour un couple gagnant 3 000 € net par mois, avec 1 enfant gardé
      160 h/mois, le mode de garde le moins cher en 2026 est <strong>{avecArticle(premier.label)}</strong>
      à <strong>{fmtEuro(premier.netReel)}/mois</strong> en coût net réel, devant
      {" "}{avecArticle(second.label)} ({fmtEuro(second.netReel)}/mois), après CMG et crédit
      d'impôt (barème au 1ᵉʳ avril 2026). Le verdict change avec vos revenus, vos heures et votre
      département : ajustez le comparateur ci-dessous.
    </p>

    <Calculator client:load />

    <section class="card-brutal p-5 text-sm leading-relaxed">
      <h2 class="text-lg font-extrabold uppercase tracking-brutal">Comment lire le verdict</h2>
      <p class="mt-3">On distingue deux chiffres que personne d'autre ne sépare clairement :</p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <li>
          <strong>Trésorerie mensuelle</strong> : ce qui part réellement de votre compte chaque mois
          (avant crédit d'impôt).
        </li>
        <li>
          <strong>Coût net réel</strong> : après crédit d'impôt (50 %), encaissé l'année suivante
          (avance de 60 % en janvier, solde en été).
        </li>
      </ul>
      <p class="mt-3 text-muted-foreground">
        Le classement se fait sur le coût net réel. Les sliders revenu et heures font basculer le
        verdict en direct — testez vos scénarios.
      </p>
    </section>

    <section>
      <h2 class="text-lg font-extrabold uppercase tracking-brutal">Pour aller plus loin</h2>
      <ul class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
        {
          [
            ["/guides/creche-ou-assistante-maternelle", "Crèche ou assistante maternelle ?"],
            ["/guides/tarif-creche-2026", "Tarif crèche 2026 : calcul CAF"],
            ["/guides/cmg-2026", "CMG 2026 : montant et calcul"],
            ["/guides/reforme-cmg-septembre-2025", "Réforme du CMG (sept. 2025)"],
            ["/guides/credit-impot-frais-de-garde", "Crédit d'impôt frais de garde"],
            ["/cout-garde-enfant", "Coût de la garde par département"],
            ["/observatoire-cout-garde-2026", "Observatoire du coût 2026 (données)"],
          ].map(([href, label]) => (
            <li>
              <a class="card-brutal-interactive block px-3 py-2 text-sm font-bold" href={href}>
                {label} →
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>
